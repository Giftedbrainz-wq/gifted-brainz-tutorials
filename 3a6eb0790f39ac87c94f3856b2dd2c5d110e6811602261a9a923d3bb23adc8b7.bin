-16T00:00:00.000Z","subject":"Mathematics","roman":false},{"id":"qb-mathematics-22","type":"mcq","passageId":"","passage":"","q":"If x² -11x +30 = 0, what is the sum of the squares of its roots?","options":["61","121","30","63"],"answer":0,"explanation":"The roots are r₁ and r₂. Their squared sum is r₁²+r₂²=(r₁+r₂)²−2r₁r₂.","image":null,"source":"Gifted Brainz UTME Standard Question Bank 2026","needsReview":false,"createdAt":"2026-08-16T00:00:00.000Z","subject":"Mathematics","roman":false},{"id":"qb-mathematics-23","type":"mcq","passageId":"","passage":"","q":"An arithmetic progression has first term 6 and common difference 5. What is its 11th term?","options":["56","61","51","121"],"answer":0,"explanation":"Use Tₙ = a + (n−1)d.","image":null,"source":"Gifted Brainz UTME Standard Question Bank 2026","needsReview":false,"createdAt":"2026-08-16T00:00:00.000Z","subject":"Mathematics","roman":false},{"id":"qb-mathematics-24","type":"mcq","passageId":"","passage":"","q":"Simplify 5^6 × 5^5.","options":["48828125","931322574615478515625","5","362797056"],"answer":0,"explanation":"For equal bases, indices are added when multiplying powers.","image":null,"source":"Gifted Brainz UTME Standard Question Bank 2026","needsReview":false,"createdAt":"2026-08-16T00:00:00.000Z","subject":"Mathematics","roman":false},{"id":"qb-mathematics-25","type":"mcq","passageId":"","passage":"","q":"A sector has radius 7 cm and central angle 105°. What is its area in terms of π?","options":["343/24π cm²","49π cm²","343/12π cm²","168π cm²"],"answer":0,"explanation":"Sector area = θ/360 × πr².","image":null,"source":"Gifted Brainz UTME Standard Question Bank 2026","needsReview":false,"createdAt":"2026-08-16T00:00:00.000Z","subject":"Mathematics","roman":false},{"id":"qb-mathematics-26","type":"mcq","passageId":"","passage":"","q":"Solve simultaneously: 5x + 4y = 49 and 4x + 5y = 50. What is the value of x?","options":["5","6","4","7"],"answer":0,"explanation":"Use elimination or substitution; the 